# Run npm run setup to create .env without overwriting an existing file.
# Credentials are server-only. Never use VITE_ variables for secrets.
# Create a key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Create a key: https://api-dashboard.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=

# Optional. Defaults below work without modification.
API_PORT=8787
APP_PORT=5173
PREVIEW_PORT=4173
DATABASE_PATH=data/marketplace.sqlite

# Address the API listens on. Keep 127.0.0.1 unless a reverse proxy on another
# machine must reach it (use this machine's LAN IP). Only allowed with Supabase
# accounts below, because the local demo has no sign-in.
API_HOST=127.0.0.1

# Keep local by default. For LAN testing, set APP_HOST=0.0.0.0 and add
# your exact phone/LAN/Tailscale origin below, including http(s) and port.
APP_HOST=127.0.0.1
APP_ALLOWED_HOSTS=
API_ALLOWED_ORIGINS=

# Optional: enable real accounts, listings and messages with Supabase.
# Create a project: https://supabase.com/dashboard
# Apply the SQL files in supabase/migrations in filename order first.
# SUPABASE_URL is what browsers use: it must be reachable from every user's
# device and HTTPS when the app is HTTPS, e.g. https://supabase.deyan.ch
# (plain HTTP is accepted only for localhost and private LAN addresses).
SUPABASE_URL=
# What this server uses to reach Supabase, e.g. http://192.168.1.46:8000 or
# http://127.0.0.1:8000. Never sent to browsers. Leave empty to use SUPABASE_URL.
SUPABASE_INTERNAL_URL=
# The anon (publishable) key. Never the service-role key.
SUPABASE_PUBLISHABLE_KEY=
# Encrypt per-user provider keys. Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Back up this server-only key; keep it unchanged when redeploying.
ACCOUNT_KEYS_ENCRYPTION_KEY=

# Optional: 250 temporary test requests for one confirmed account (local dev only).
# Set an email and an ISO expiry within 24 hours. Disabled for production/--serve.
LOCAL_AI_TEST_EMAIL=
LOCAL_AI_TEST_UNTIL=
